@only-if workflows
name: infra

on:
  pull_request:
    paths:
      - "infra/**"
  push:
    branches: [main]
    paths:
      - "infra/**"
  workflow_dispatch:

permissions: {}

concurrency:
  group: infra-${{ github.ref }}
  cancel-in-progress: false

jobs:
  validate:
    runs-on: ubuntu-latest
    permissions: {}
    strategy:
      matrix:
        root: [foundation, instance]
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "__TERRAFORM_VERSION__"
      - run: terraform fmt -check -recursive
        working-directory: infra/${{ matrix.root }}
      - run: terraform init -backend=false
        working-directory: infra/${{ matrix.root }}
      - run: terraform validate
        working-directory: infra/${{ matrix.root }}

  plan:
    if: github.event_name == 'pull_request' && vars.AZURE_FOUNDATION_READY == 'true'
    needs: validate
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    strategy:
      matrix:
        root: [foundation, instance]
    env:
      ARM_USE_OIDC: "true"
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "__TERRAFORM_VERSION__"
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      - run: |
          terraform init \
            -backend-config="resource_group_name=${{ vars.TFSTATE_RESOURCE_GROUP }}" \
            -backend-config="storage_account_name=${{ vars.TFSTATE_STORAGE_ACCOUNT }}" \
            -backend-config="container_name=tfstate" \
            -backend-config="key=__NAME__/${{ matrix.root }}.tfstate"
        working-directory: infra/${{ matrix.root }}
      - run: terraform plan -var-file=../env/dev.tfvars
        working-directory: infra/${{ matrix.root }}

  apply:
    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.AZURE_FOUNDATION_READY == 'true'
    needs: validate
    runs-on: ubuntu-latest
    environment: dev
    permissions:
      id-token: write
      contents: read
    env:
      ARM_USE_OIDC: "true"
      ARM_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
      ARM_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
      ARM_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "__TERRAFORM_VERSION__"
      - uses: azure/login@v2
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      - run: |
          for root in foundation instance; do
            (
              cd "infra/$root"
              terraform init \
                -backend-config="resource_group_name=${{ vars.TFSTATE_RESOURCE_GROUP }}" \
                -backend-config="storage_account_name=${{ vars.TFSTATE_STORAGE_ACCOUNT }}" \
                -backend-config="container_name=tfstate" \
                -backend-config="key=__NAME__/$root.tfstate"
              terraform plan -var-file=../env/dev.tfvars -out=tfplan
              terraform apply tfplan
            )
          done
