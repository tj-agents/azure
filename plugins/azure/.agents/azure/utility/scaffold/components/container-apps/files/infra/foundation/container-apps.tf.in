resource "azurerm_container_registry" "main" {
  name                = substr("${local.compact}cr", 0, 24)
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location

  sku           = "Basic"
  admin_enabled = false

  tags = local.tags

  lifecycle {
    precondition {
      condition     = length(substr("${local.compact}cr", 0, 24)) <= 24
      error_message = "registry name must be 24 characters or fewer."
    }
  }
}

resource "azurerm_container_app_environment" "main" {
  name                       = "${local.prefix}-cae"
  resource_group_name        = azurerm_resource_group.main.name
  location                   = azurerm_resource_group.main.location
  log_analytics_workspace_id = azurerm_log_analytics_workspace.main.id

@if vnet
  infrastructure_subnet_id = var.private_networking ? azurerm_subnet.cae.id : null
@endif

  tags = local.tags
}
