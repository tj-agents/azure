{
  "version": "2.0.0",
  "options": {
    "http_host": {
      "type": "enum",
      "values": ["container-apps", "app-service"],
      "default": "container-apps",
      "description": "Compute host for an `http` workload."
    },
    "background_host": {
      "type": "enum",
      "values": ["container-apps"],
      "default": "container-apps",
      "description": "Compute host for a `background` workload."
    },
    "functions_host": {
      "type": "enum",
      "values": ["flex-consumption", "container-apps"],
      "default": "flex-consumption",
      "description": "Compute host for a `functions` workload."
    },
    "messaging": {
      "type": "enum",
      "values": ["none", "service-bus"],
      "default": "none",
      "description": "Messaging for this instance."
    },
    "topics": {
      "type": "list",
      "default": [],
      "pattern": "^[a-z][a-z0-9-]{0,49}$",
      "requires": { "messaging": "service-bus" },
      "description": "Topic names this instance's foundation creates; a workload publishes and consumes them through the profile's `messaging` field."
    },
    "key_vault": {
      "type": "bool",
      "default": false,
      "description": "Add a Key Vault."
    },
    "vnet": {
      "type": "bool",
      "default": false,
      "description": "Add a VNet; required for `private_networking`."
    },
    "workflows": {
      "type": "bool",
      "default": true,
      "description": "Write `.github/workflows/infra.yml`."
    },
    "terraform_version": {
      "type": "string",
      "default": "1.16.5",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Terraform CLI version pinned in CI."
    },
    "azurerm_version": {
      "type": "string",
      "default": "~> 5.0",
      "description": "azurerm provider version constraint."
    }
  }
}
