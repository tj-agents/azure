{
  "version": "1.0.0",
  "options": {
    "name": {
      "type": "string",
      "required": true,
      "pattern": "^[a-z][a-z0-9]{1,11}$",
      "description": "Workload name, lowercase, 2-12 characters."
    },
    "host": {
      "type": "enum",
      "values": ["none", "container-apps", "app-service"],
      "default": "none",
      "description": "Compute host for the workload."
    },
    "database": {
      "type": "enum",
      "values": ["none", "postgres-flexible"],
      "default": "none",
      "description": "Database for the workload."
    },
    "messaging": {
      "type": "enum",
      "values": ["none", "service-bus"],
      "default": "none",
      "description": "Messaging for the workload."
    },
    "topics": {
      "type": "list",
      "default": [],
      "pattern": "^[a-z][a-z0-9-]{0,49}$",
      "requires": { "messaging": "service-bus" },
      "description": "Topic names this workload's foundation creates."
    },
    "subscriptions": {
      "type": "list",
      "default": [],
      "requires": { "messaging": "service-bus" },
      "description": "Topics this workload consumes; each must also be listed in `topics`."
    },
    "key_vault": {
      "type": "bool",
      "default": false,
      "description": "Add a Key Vault."
    },
    "vnet": {
      "type": "bool",
      "default": false,
      "description": "Add a VNet; required for `private_networking`."
    },
    "workflows": {
      "type": "bool",
      "default": true,
      "description": "Write `.github/workflows/infra.yml`."
    },
    "terraform_version": {
      "type": "string",
      "default": "1.16.5",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Terraform CLI version pinned in CI."
    },
    "azurerm_version": {
      "type": "string",
      "default": "~> 5.0",
      "description": "azurerm provider version constraint."
    }
  }
}
