resource "azurerm_postgresql_flexible_server" "main" {
  name                = "${local.prefix}-psql"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location

  version    = "17"
  sku_name   = var.postgres_sku
  storage_mb = 32768

@if vnet
  public_network_access_enabled = !var.private_networking
@endif
@if !vnet
  public_network_access_enabled = true
@endif

  authentication {
    active_directory_auth_enabled = true
    password_auth_enabled         = false
    tenant_id                     = data.azurerm_client_config.current.tenant_id
  }

  tags = local.tags
}

@if vnet
resource "azurerm_postgresql_flexible_server_firewall_rule" "azure_services" {
  count            = var.private_networking ? 0 : 1
  name             = "allow-azure-services"
  server_id        = azurerm_postgresql_flexible_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}
@endif
@if !vnet
resource "azurerm_postgresql_flexible_server_firewall_rule" "azure_services" {
  name             = "allow-azure-services"
  server_id        = azurerm_postgresql_flexible_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}
@endif

@if vnet
resource "azurerm_private_dns_zone" "postgres" {
  count               = var.private_networking ? 1 : 0
  name                = "privatelink.postgres.database.azure.com"
  resource_group_name = azurerm_resource_group.main.name

  tags = local.tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "postgres" {
  count               = var.private_networking ? 1 : 0
  name                = "${local.prefix}-psql-link"
  private_dns_zone_id = azurerm_private_dns_zone.postgres[0].id
  virtual_network_id  = azurerm_virtual_network.main.id

  tags = local.tags
}

resource "azurerm_private_endpoint" "postgres" {
  count               = var.private_networking ? 1 : 0
  name                = "${local.prefix}-psql-pe"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  subnet_id           = azurerm_subnet.private_endpoints.id

  private_service_connection {
    name                           = "${local.prefix}-psql-psc"
    private_connection_resource_id = azurerm_postgresql_flexible_server.main.id
    subresource_names              = ["postgresqlServer"]
    is_manual_connection           = false
  }

  private_dns_zone_group {
    name                 = "postgres"
    private_dns_zone_ids = [azurerm_private_dns_zone.postgres[0].id]
  }

  tags = local.tags
}
@endif

resource "azurerm_monitor_diagnostic_setting" "postgres" {
  name                       = "${local.prefix}-psql-diag"
  target_resource_id         = azurerm_postgresql_flexible_server.main.id
  log_analytics_workspace_id = azurerm_log_analytics_workspace.main.id

  enabled_log {
    category_group = "allLogs"
  }

  enabled_metric {
    category = "AllMetrics"
  }
}
