resource "azurerm_storage_account" "function" {
  for_each = local.functions_workloads

  name                = substr("${local.compact}${replace(each.key, "-", "")}fn", 0, 24)
  resource_group_name = data.azurerm_resource_group.main.name
  location            = data.azurerm_resource_group.main.location

  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  shared_access_key_enabled       = false
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false

  tags = local.tags

  lifecycle {
    precondition {
      condition     = length(substr("${local.compact}${replace(each.key, "-", "")}fn", 0, 24)) <= 24
      error_message = "function storage account name must be 24 characters or fewer."
    }
  }
}

resource "azurerm_storage_container" "function" {
  for_each = local.functions_workloads

  name                  = "deployments"
  storage_account_id    = azurerm_storage_account.function[each.key].id
  container_access_type = "private"
}

resource "azurerm_role_assignment" "function_storage_blob_owner" {
  for_each = local.functions_workloads

  scope                = azurerm_storage_account.function[each.key].id
  role_definition_name = "Storage Blob Data Owner"
  principal_id         = azurerm_user_assigned_identity.workload[each.key].principal_id

  depends_on = [time_sleep.workload_identity_propagation]
}

resource "azurerm_role_assignment" "function_storage_queue_contributor" {
  for_each = local.functions_workloads

  scope                = azurerm_storage_account.function[each.key].id
  role_definition_name = "Storage Queue Data Contributor"
  principal_id         = azurerm_user_assigned_identity.workload[each.key].principal_id

  depends_on = [time_sleep.workload_identity_propagation]
}

resource "azurerm_role_assignment" "function_storage_table_contributor" {
  for_each = local.functions_workloads

  scope                = azurerm_storage_account.function[each.key].id
  role_definition_name = "Storage Table Data Contributor"
  principal_id         = azurerm_user_assigned_identity.workload[each.key].principal_id

  depends_on = [time_sleep.workload_identity_propagation]
}

resource "time_sleep" "function_storage_role_propagation" {
  for_each = local.functions_workloads

  create_duration = "60s"

  depends_on = [
    azurerm_role_assignment.function_storage_blob_owner,
    azurerm_role_assignment.function_storage_queue_contributor,
    azurerm_role_assignment.function_storage_table_contributor,
  ]
}
